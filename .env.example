# JobHub Environment Variables Example
# Copy this file to .env.local to connect to your live Supabase project

# Supabase Project URL & Anon Key (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Supabase Service Role Key (For server-side administrative tasks only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# App Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
